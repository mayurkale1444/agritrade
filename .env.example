# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATA_GOV_IN_API_KEY: Optional free API key from data.gov.in for live AGMARKNET mandi prices.
# Obtain freely at https://data.gov.in/ (Register -> My Account -> Create API Key).
DATA_GOV_IN_API_KEY=""

# PRODUCTION REAL SMS OTP GATEWAY (Choose one provider):
# Option 1: Fast2SMS (India Bulk SMS API)
FAST2SMS_API_KEY=""

# Option 2: Twilio SMS (Global SMS API)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option 3: MSG91 (India DLT SMS API)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Option 4: Custom SMS Webhook
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
